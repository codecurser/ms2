# Vercel / Frontend Environment Variables
# Set these in your Vercel Project Settings -> Environment Variables

# Base URL for exam-service (MS2) on Render (must include /api/v1)
VITE_EXAM_API_BASE=https://ms2.onrender.com/api/v1

# Base URL for auth-service (MS1) on Render (must include /api/v1/auth)
VITE_AUTH_API_BASE=https://microservice-based-examination.onrender.com/api/v1/auth
